{
  "name": "twibook-extension",
  "displayName": "TwiBook",
  "version": "0.0.1",
  "description": "Create detailed bookmarks without leaving Twitter",
  "author": "Caleb Olojo",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@plasmohq/messaging": "0.6.2",
    "@plasmohq/storage": "1.9.3",
    "@supabase/supabase-js": "2.39.3",
    "@tanstack/react-query": "^5.28.12",
    "dayjs": "^1.11.10",
    "formik": "^2.4.5",
    "lucide-react": "^0.363.0",
    "next": "^14.1.4",
    "node-forge": "^1.3.1",
    "plasmo": "0.85.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "rettiwt-api": "^2.6.2",
    "sass": "^1.72.0",
    "wildcard-match": "^5.1.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "key": "$CRX_KEY",
    "host_permissions": [
      "https://*/*"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "options.html"
        ],
        "matches": [
          "<all_urls>"
        ],
        "extension_ids": [
          "$CRX_ID"
        ]
      }
    ]
  }
}
